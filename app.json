{
  "expo": {
    "name": "MyBudget",
    "slug": "mybudget",
    "version": "0.1.0",
    "scheme": "clairdepenses",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "backgroundColor": "#FAF8F1",
    "icon": "./assets/branding/mybudget-icon.png",
    "android": {
      "package": "fr.remid.depenseslocales",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/mybudget-adaptive-foreground.png",
        "backgroundColor": "#1E342C"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/mybudget-adaptive-foreground.png",
          "imageWidth": 256,
          "resizeMode": "contain",
          "backgroundColor": "#1E342C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/mybudget-favicon.png",
      "name": "MyBudget"
    }
  }
}
