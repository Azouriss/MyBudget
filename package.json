{
  "name": "mybudget",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-expo-sqlite-web.cjs && node scripts/fix-expo-web-headers.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm test && npm run test:release-tools",
    "test:release-tools": "node scripts/__tests__/release.test.cjs",
    "release:check": "node scripts/check-release.cjs && npm run check && node scripts/check-release.cjs",
    "release:verify-apk": "node scripts/verify-apk-update.cjs",
    "release:lock-migrations": "node scripts/lock-migrations.cjs",
    "prebuild:android": "npm run release:check",
    "eas-build-post-install": "npm run release:check",
    "db:generate": "drizzle-kit generate",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "web": "expo start --web --localhost",
    "setup:web": "expo install react-dom react-native-web",
    "build:android:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@hookform/resolvers": "^5.2.2",
    "drizzle-orm": "0.44.5",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "0.544.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "babel-plugin-inline-import": "3.0.0",
    "babel-preset-expo": "~57.0.16",
    "drizzle-kit": "0.31.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
